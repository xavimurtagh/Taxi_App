# =============================================================================
# OpenRide — Production Environment Configuration
# =============================================================================
#
# Copy this file to .env.production on your production server and fill in
# all values. This file contains production-specific overrides and settings.
#
# CRITICAL: This file contains secrets. Never commit it to version control!
#
# Generate secure secrets with:
#   openssl rand -base64 64
#
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Your production domain — used for CORS and cookie configuration
CORS_ORIGIN=https://openride.community

# ── Database ─────────────────────────────────────────────────────────────────
# In the Docker Compose setup, the API connects to the postgres container
# using the internal Docker network. These values are used by
# docker-compose.prod.yml to construct the DATABASE_URL automatically.
POSTGRES_DB=openride
POSTGRES_USER=openride
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_PASSWORD

# ── Redis ────────────────────────────────────────────────────────────────────
# Password for Redis authentication. Used by the redis container and the API.
REDIS_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_PASSWORD

# ── JWT Authentication ───────────────────────────────────────────────────────
# REQUIRED: Generate unique, strong secrets for production.
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_STRONG_SECRET
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Stripe Connect ──────────────────────────────────────────────────────────
# Use your LIVE keys, not test keys!
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# ── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC_CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=+15551234567

# ── S3 / Object Storage ─────────────────────────────────────────────────────
S3_BUCKET=openride-uploads
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_ENDPOINT=
S3_REGION=us-east-1

# ── External Services ───────────────────────────────────────────────────────
# In production, these should point to your actual service URLs.
# If running OSRM in Docker, use the container name as hostname.
OSRM_URL=http://osrm:5000
GEOCODING_URL=http://geocoding:4000
SENTRY_DSN=https://CHANGE_ME@sentry.io/CHANGE_ME

# ── Fare Configuration ──────────────────────────────────────────────────────
PLATFORM_FEE_PERCENT=7
BASE_FARE=2.50
PER_KM_RATE=1.20
PER_MINUTE_RATE=0.20
MINIMUM_FARE=5.00
SURGE_CAP=1.5

# ── Docker Image Tag ────────────────────────────────────────────────────────
# Set by the CI/CD pipeline. Defaults to 'latest' if not specified.
IMAGE_TAG=latest

# ── Backup Configuration ────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=7
S3_BACKUP_BUCKET=openride-backups
S3_BACKUP_PREFIX=openride/db-backups
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=us-east-1

# Webhook URL for backup failure alerts (Slack or Discord webhook)
BACKUP_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME

# ── SSL Configuration ───────────────────────────────────────────────────────
# Domain for SSL certificate generation (used by init-letsencrypt.sh)
SSL_DOMAIN=openride.community
SSL_EMAIL=admin@openride.community
