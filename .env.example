# ──────────────────────────────────────────────
# OpenRide Environment Configuration
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────

# ── Application ────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (PostgreSQL + PostGIS) ────────────
DATABASE_URL=postgres://openride:openride@localhost:5432/openride

# ── Redis ──────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Stripe Connect ─────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Twilio ─────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── S3 / Object Storage ───────────────────────
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_REGION=us-east-1

# ── External Services ─────────────────────────
OSRM_URL=http://localhost:5001
GEOCODING_URL=http://localhost:4000
SENTRY_DSN=

# ── Fare Configuration ────────────────────────
PLATFORM_FEE_PERCENT=7
BASE_FARE=2.50
PER_KM_RATE=1.20
PER_MINUTE_RATE=0.20
MINIMUM_FARE=5.00
SURGE_CAP=1.5
