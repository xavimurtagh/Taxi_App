# =============================================================================
# OpenRide — Environment Configuration
# =============================================================================
#
# Copy this file to .env and fill in the values for your environment.
# For production, see .env.production.example for production-specific overrides.
#
# IMPORTANT: Never commit the .env file to version control!
#
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
# NODE_ENV: Runtime environment. Values: development, test, production
NODE_ENV=development

# PORT: HTTP port the API server listens on
PORT=3000

# CORS_ORIGIN: Allowed origin for cross-origin requests.
# In development, set to '*' or your frontend URL.
# In production, set to your actual domain (e.g., https://openride.community)
CORS_ORIGIN=*

# ── Database (PostgreSQL + PostGIS) ──────────────────────────────────────────
# DATABASE_URL: PostgreSQL connection string.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# The database must have the PostGIS extension installed.
DATABASE_URL=postgres://openride:openride@localhost:5432/openride

# ── Redis ────────────────────────────────────────────────────────────────────
# REDIS_URL: Redis connection string for caching, sessions, and Socket.IO.
# Format: redis://[:PASSWORD@]HOST:PORT
# For production with password: redis://:yourpassword@redis:6379
REDIS_URL=redis://localhost:6379

# ── JWT Authentication ───────────────────────────────────────────────────────
# JWT_SECRET: Secret key for signing access tokens.
# REQUIRED in production. Generate with: openssl rand -base64 64
JWT_SECRET=

# JWT_REFRESH_SECRET: Secret key for signing refresh tokens.
# Must be different from JWT_SECRET. Generate with: openssl rand -base64 64
JWT_REFRESH_SECRET=

# JWT_EXPIRY: Access token expiration time (e.g., 15m, 1h, 1d)
JWT_EXPIRY=15m

# JWT_REFRESH_EXPIRY: Refresh token expiration time (e.g., 7d, 30d)
JWT_REFRESH_EXPIRY=7d

# ── Stripe Connect (Payment Processing) ─────────────────────────────────────
# STRIPE_SECRET_KEY: Stripe API secret key (starts with sk_test_ or sk_live_)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET: Stripe webhook signing secret (starts with whsec_)
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=

# ── Twilio (SMS / Phone Verification) ───────────────────────────────────────
# TWILIO_ACCOUNT_SID: Twilio account identifier (starts with AC)
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=

# TWILIO_AUTH_TOKEN: Twilio authentication token
TWILIO_AUTH_TOKEN=

# TWILIO_PHONE_NUMBER: Twilio phone number for sending SMS (e.g., +15551234567)
TWILIO_PHONE_NUMBER=

# ── S3 / Object Storage (File Uploads) ──────────────────────────────────────
# S3_BUCKET: Bucket name for file uploads (profile photos, documents, etc.)
S3_BUCKET=

# S3_ACCESS_KEY: AWS access key ID (or compatible S3 provider)
S3_ACCESS_KEY=

# S3_SECRET_KEY: AWS secret access key (or compatible S3 provider)
S3_SECRET_KEY=

# S3_ENDPOINT: Custom endpoint for S3-compatible services (e.g., DigitalOcean Spaces, MinIO)
# Leave empty for AWS S3. Example: https://nyc3.digitaloceanspaces.com
S3_ENDPOINT=

# S3_REGION: AWS region for the S3 bucket
S3_REGION=us-east-1

# ── External Services ───────────────────────────────────────────────────────
# OSRM_URL: OSRM (Open Source Routing Machine) server URL for route calculations
OSRM_URL=http://localhost:5001

# GEOCODING_URL: Geocoding service URL for address <-> coordinate conversion
GEOCODING_URL=http://localhost:4000

# SENTRY_DSN: Sentry error tracking DSN (Data Source Name)
# Get from: https://sentry.io/settings/projects/
SENTRY_DSN=

# ── Fare Configuration ──────────────────────────────────────────────────────
# These values control how ride fares are calculated.

# PLATFORM_FEE_PERCENT: Percentage of fare taken as platform fee (e.g., 7 = 7%)
PLATFORM_FEE_PERCENT=7

# BASE_FARE: Fixed starting fare for every ride (in local currency)
BASE_FARE=2.50

# PER_KM_RATE: Cost per kilometer traveled
PER_KM_RATE=1.20

# PER_MINUTE_RATE: Cost per minute of ride time
PER_MINUTE_RATE=0.20

# MINIMUM_FARE: Minimum fare charged for any ride
MINIMUM_FARE=5.00

# SURGE_CAP: Maximum surge pricing multiplier (e.g., 1.5 = 150% of normal fare)
SURGE_CAP=1.5

# ── Docker / Infrastructure ─────────────────────────────────────────────────
# These variables are used by docker-compose.prod.yml

# POSTGRES_DB: PostgreSQL database name (used by the postgres container)
POSTGRES_DB=openride

# POSTGRES_USER: PostgreSQL username (used by the postgres container)
POSTGRES_USER=openride

# POSTGRES_PASSWORD: PostgreSQL password (REQUIRED — used by the postgres container)
POSTGRES_PASSWORD=

# REDIS_PASSWORD: Redis authentication password (REQUIRED in production)
REDIS_PASSWORD=

# IMAGE_TAG: Docker image tag to deploy (set by CI/CD, defaults to 'latest')
IMAGE_TAG=latest

# ── Backup Configuration ────────────────────────────────────────────────────
# BACKUP_RETENTION_DAYS: Number of days to keep local database backups
BACKUP_RETENTION_DAYS=7

# S3_BACKUP_BUCKET: S3 bucket for storing database backups (optional)
S3_BACKUP_BUCKET=

# S3_BACKUP_PREFIX: S3 key prefix for backup files
S3_BACKUP_PREFIX=openride/db-backups

# AWS_ACCESS_KEY_ID: AWS credentials for backup uploads (can differ from S3_ACCESS_KEY)
AWS_ACCESS_KEY_ID=

# AWS_SECRET_ACCESS_KEY: AWS credentials for backup uploads
AWS_SECRET_ACCESS_KEY=

# AWS_DEFAULT_REGION: AWS region for backup bucket
AWS_DEFAULT_REGION=us-east-1

# BACKUP_WEBHOOK_URL: Webhook URL for backup failure notifications (Slack/Discord)
BACKUP_WEBHOOK_URL=
